{
  "name": "@nexusmc-cn/axnexus",
  "version": "0.2.0",
  "description": "A small, typed, fetch-based HTTP client with Axios-style instances.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NexusMC-CN/axnexus.git"
  },
  "homepage": "https://github.com/NexusMC-CN/axnexus#readme",
  "bugs": {
    "url": "https://github.com/NexusMC-CN/axnexus/issues"
  },
  "keywords": [
    "fetch",
    "request",
    "http",
    "https",
    "http-client",
    "network",
    "ajax",
    "api",
    "rest",
    "xhr",
    "browser",
    "nodejs",
    "bun",
    "typescript",
    "axios",
    "retry",
    "timeout",
    "cache",
    "abortcontroller"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./node-http2": {
      "types": "./dist/adapters/node-http2.d.ts",
      "import": "./dist/adapters/node-http2.js"
    },
    "./node-http3": {
      "types": "./dist/adapters/node-http3.d.ts",
      "import": "./dist/adapters/node-http3.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "build": "npm run clean && tsc -p tsconfig.json",
    "build:bun": "bun scripts/clean.mjs && bun x tsc -p tsconfig.json",
    "test": "npm run build && node --test --experimental-strip-types \"tests/**/*.test.ts\"",
    "test:bun": "bun run build:bun && bun test tests",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  }
}
